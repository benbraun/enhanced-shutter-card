{
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npx rollup -c && npm run gzip",
    "gzip": "node scripts/gzip.mjs",
    "watch": "rollup -c --watch",
    "test": "npm run test:tdbu && npm run test:transition && npm run test:movement && npm run test:images",
    "test:tdbu": "node test/tdbuSmoke.mjs",
    "test:transition": "node test/transitionSmoke.mjs",
    "test:movement": "node test/movementSmoke.mjs",
    "test:images": "node --test test/imageLoading.mjs"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "jsdom": "^31.0.0",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.2",
    "rollup-plugin-copy": "^3.5.0"
  }
}
